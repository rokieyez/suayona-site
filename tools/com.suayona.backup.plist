<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  주마다 백업을 받게 하는 맥의 자동 실행 설정.
  이 파일은 원본(보관용)이고, 실제로 도는 것은 ~/Library/LaunchAgents/ 에 복사된 쪽이다.

  걸기:
    cp tools/com.suayona.backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.suayona.backup.plist

  풀기:
    launchctl bootout gui/$UID/com.suayona.backup
    rm ~/Library/LaunchAgents/com.suayona.backup.plist

  지금 당장 한 번 돌려보기:
    launchctl kickstart -p gui/$UID/com.suayona.backup
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.suayona.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/mac/Downloads/suayona-site/tools/backup-weekly.sh</string>
  </array>

  <!-- 일요일 밤 9시. 새벽으로 잡으면 노트북이 자고 있어서 건너뛰기 쉽다.
       맥이 꺼져 있었으면 다음에 켰을 때 알아서 한 번 돈다. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>21</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- 로그인하자마자 돌지는 않게. 주마다 정한 때에만. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- 쓰던 일을 방해하지 않도록 뒤에서 천천히 -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>

  <!-- 스크립트가 남기는 기록과 같은 곳으로 모은다 -->
  <key>StandardOutPath</key>
  <string>/Users/mac/Library/Logs/suayona-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mac/Library/Logs/suayona-backup.log</string>
</dict>
</plist>
